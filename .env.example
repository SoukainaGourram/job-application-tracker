# ──────────────────────────────────────────────────────────────────────────────
# JobTrack — Variables d'environnement
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir toutes les valeurs nécessaires
#   3. Ne JAMAIS commiter le fichier .env
# ──────────────────────────────────────────────────────────────────────────────

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# En exécution locale directe : localhost
# En exécution Docker Compose : postgres
DB_HOST=postgres
# Port externe exposé sur l'hôte (5434 pour éviter tout conflit avec 5432)
DB_PORT=5434
DB_NAME=jobtrack
DB_USERNAME=jobtrack_user
DB_PASSWORD=jobtrack_dev_password

# ─── Ports d'écoute des services ──────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=4200

# ─── Sécurité JWT ─────────────────────────────────────────────────────────────
# Minimum 256 bits (32 octets) encodé en Base64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# ─── Frontend CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
