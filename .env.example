# ──────────────────────────────────────────────────────────────────────────────
# JobTrack — Variables d'environnement
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir toutes les valeurs marquées CHANGE_ME
#   3. Ne JAMAIS commiter le fichier .env
# ──────────────────────────────────────────────────────────────────────────────

# ─── Base de données ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtrack
DB_USERNAME=jobtrack_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64 | tr -d '\n'
# Minimum 256 bits (32 octets) pour HS256
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_256_BITS_BASE64_ENCODED
JWT_EXPIRATION=86400000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
